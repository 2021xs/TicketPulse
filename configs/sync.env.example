# External, already provisioned components. This template is intentionally not runnable.
# Copy into .local/, chmod 600, replace every placeholder, then source that private copy.
# Native fixtures generate their own values; do not source this for retained instances.
export TICKETPULSE_DSN='ticketpulse:<business-db-password>@tcp(<mysql-host>:<mysql-port>)/<schema>'
export TICKETPULSE_SYNC_DSN='ticketpulse_sync:<sync-db-password>@tcp(<mysql-host>:<mysql-port>)/<schema>'
export TICKETPULSE_CONTROL_DSN='ticketpulse_control:<control-db-password>@tcp(<mysql-host>:<mysql-port>)/<schema>'
export TICKETPULSE_HTTP_LISTEN='127.0.0.1:<private-api-port>'
export TICKETPULSE_CDC_ADDR='<mysql-host>:<mysql-port>'
export TICKETPULSE_CDC_USER='ticketpulse_cdc'
export TICKETPULSE_CDC_PASSWORD='<replication-password>'
export TICKETPULSE_KAFKA_BROKERS='<broker-host>:<broker-port>'
# Choose before creating the Topic. Existing Topics require explicit repartitioning review.
export TICKETPULSE_KAFKA_PARTITIONS='3'
export TICKETPULSE_KAFKA_REPLICATION_FACTOR='1'
export TICKETPULSE_KAFKA_MIN_INSYNC_REPLICAS='1'
export TICKETPULSE_ES_URL='http://<es-host>:<es-port>'
export TICKETPULSE_SEARCH_INDEX='<schema>_tickets_v1'
# Optional: omit both variables for an M2-only deployment.
export TICKETPULSE_CK_URL='http://<ck-host>:<ck-port>'
export TICKETPULSE_CK_DATABASE='<schema>_analytics_v1'
# Stable 32-byte hex key; managed API requires it. Store only in the private copy.
export TICKETPULSE_CURSOR_KEY='<64-hex-characters>'
# Enable only after installing/initializing 011; read-init is a separate operator step.
# export TICKETPULSE_REQUIRE_WRITE_GATE='true'
# export TICKETPULSE_TARGET_VERSION='<expected-selected-version>'
